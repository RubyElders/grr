{
  "name": "grr-ui",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "scripts": {
    "tauri": "tauri",
    "dev": "vite --port 1420 --strictPort",
    "dev:app": "tauri dev",
    "build": "tsc --noEmit && vite build",
    "build:app": "tauri build --no-bundle -- --locked",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:audit": "node --test scripts/npm-audit.test.mjs",
    "test:scripts": "node --test scripts/npm-audit.test.mjs scripts/linux-desktop.test.mjs",
    "check": "npm run check:ui && npm run check:rust && npm run build:app",
    "check:ui": "npm run test:scripts && npm run typecheck && npm run test:coverage && npm run build",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check && cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings && npm run test:rust",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "coverage:rust": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --locked --workspace --all-targets --ignore-filename-regex \"src/main[.]rs$\" --fail-under-lines 85",
    "check:linux": "node scripts/check-linux.mjs",
    "audit": "node scripts/npm-audit.mjs",
    "audit:rust": "cargo deny --manifest-path src-tauri/Cargo.toml check advisories licenses sources",
    "audit:secrets": "gitleaks git --redact --log-opts=--all .",
    "audit:all": "npm run audit:rust && npm run audit && npm run audit:secrets",
    "test:e2e": "wdio run e2e/wdio.conf.ts",
    "test:e2e:linux": "xvfb-run -a npm run test:e2e",
    "test:multi-instance:linux": "xvfb-run -a dbus-run-session -- node e2e/multi-instance.mjs",
    "install:local": "npm run build && cargo install --path src-tauri --locked --features custom-protocol && npm run install:desktop:linux",
    "install:desktop:linux": "node scripts/linux-desktop.mjs install",
    "uninstall:local": "npm run uninstall:desktop:linux && cargo uninstall grr",
    "uninstall:desktop:linux": "node scripts/linux-desktop.mjs uninstall"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/preact": "3.2.4",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "@wdio/cli": "9.32.0",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/tauri-service": "1.4.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  },
  "overrides": {
    "webdriverio": "9.32.0",
    "@puppeteer/browsers": "3.2.3",
    "basic-ftp": "6.2.1",
    "mocha": {
      ".": "11.7.5",
      "diff": "8.0.4"
    },
    "serialize-javascript": "7.1.2"
  }
}
